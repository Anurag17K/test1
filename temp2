name: Hybrid Blockchain CI/CD

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: hybrid-blockchain-supply-chain/app

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
          aws-region: us-east-1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install awsebcli

      - name: Run Verification Gate
        run: |
          PRODUCT_ID=P001
          
          # Note: Ensure this URL is complete in your actual file. It appears truncated in your paste.
          RESPONSE=$(curl -s http://hybrid-blockchain-env.eba-vzahpwuk.us-east-1.elasticbeanstalk.com/api/verify-deployment/$PRODUCT_ID)
          
          echo "$RESPONSE"
          
          if echo "$RESPONSE" | grep -q '"deployment_allowed":true'; then
            echo "Verification PASSED"
          else
            echo "Verification FAILED"
            exit 1
          fi

      - name: Check EB CLI
        run: |
          eb --version

      - name: Deploy to Elastic Beanstalk
        run: |
          eb deploy hybrid-blockchain-env
